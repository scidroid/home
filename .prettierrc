{
  "trailingComma": "none",
  "arrowParens": "avoid",
  "singleQuote": false,
  "printWidth": 80,
  "useTabs": false,
  "tabWidth": 2,
  "semi": true,
  "importOrder": [
    "^(next(.*)$)",
    "^(react(.*)$)",
    "<THIRD_PARTY_MODULES>",
    "^components/(.*)$",
    "^@/lib/(.*)$",
    "^@/utils/(.*)$",
    "^@/public/(.*)$",
    "^@/styles/(.*)$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "plugins": [
    "prettier-plugin-tailwindcss",
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-svelte"
  ]
}
