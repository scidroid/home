SPOTIFY_CLIENT_SECRET=""            # Spotify app client secret
SPOTIFY_REFRESH_TOKEN=""            # OAuth refresh token (scopes: user-read-currently-playing, user-read-recently-played)

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=""               # API token for Telegram bot
TELEGRAM_CHAT_ID=""                 # Chat ID for Telegram notifications
TELEGRAM_WEBHOOK_SECRET=""          # Secret token to verify webhook requests
